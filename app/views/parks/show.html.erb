<p class="text-green-600 text-center"><%= notice %></p>

<% content_for :title, @park.name || "Park Details" %>

<h1 class="text-3xl font-bold text-center my-6">公園の詳細</h1>

<div class="max-w-2xl mx-auto border border-black p-6 rounded shadow-md bg-white space-y-4">
  <%= render @park %>

  <% if @park.image.attached? %>
    <div class="text-center">
      <%= image_tag url_for(@park.image), class: "w-64 h-auto object-cover rounded mx-auto" %>
    </div>
  <% end %>

  <div class="text-center space-x-4 mt-6">
    <%= link_to "この公園を編集", edit_park_path(@park), class: "text-blue-600 hover:underline" %>
    |
    <%= link_to "投稿一覧に戻る", parks_path, class: "text-blue-600 hover:underline" %>
    |
    <%= link_to "削除", park_path(@park), data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" }, class: "text-blue-600 hover:underline" %>
  </div>
  <div class="mt-8 space-y-4">
    <h2 class="text-lg font-semibold">コメント</h2>
    <% @park.comments.order(created_at: :desc).each do |comment| %>
      <div class="border border-gray-300 rounded p-3 bg-gray-100">
        <p><%= comment.content %></p>
        <span class="text-xs text-gray-500"><%= comment.created_at.strftime("%Y-%m-%d %H:%M") %></span>
      </div>
    <% end %>
  </div>

  <!-- コメント投稿フォーム -->
  <div class="mt-6">
    <%= form_with(model: [@park, @park.comments.build], local: true) do |form| %>
      <div class="mb-2">
        <%= form.label :content, "コメントを入力", class: "block font-semibold" %>
        <%= form.text_area :content, rows: 3, class: "w-full border border-gray-300 rounded p-2" %>
      </div>
      <%= form.submit "投稿", class: "bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600" %>
    <% end %>
  </div>
</div>
